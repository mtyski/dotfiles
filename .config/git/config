[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[pull]
	rebase = true
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[alias]
	plog = log --graph --format=format:'%C(auto)%h %C(bold blue)%an%C(auto)%d %C(green)%ad%C(reset)%n%w(80,8,8)%s' --date=human
	rmd = !git remote prune origin && git branch -vv | grep \": gone]\" | grep -v \"+\" | awk '{print $1}' | xargs -r git branch -D
	majonez = !git switch $(basename $(git rev-parse --abbrev-ref origin/HEAD)) && git pull --all && git rmd
	who-fucked-with = !sh -c 'git shortlog HEAD..origin/$0'
	whazzap = !sh -c 'git fetch' && git log --oneline HEAD..origin/$1
	fucking-commits-diff-for = !sh -c 'git cherry -v $0'
	sync-with-fucking = !sh -c 'git fetch && git rebase $0 $@'
	fucking-sorry = commit --amend --no-edit
	fucking-sorry-yolo = !sh -c 'git commit --amend --no-edit $@ && git push -f'
	wtf = status
	last-fucking-commit = log --oneline -1
	pick-a-fucking-lane = !$HOME/.local/bin/pick-a-lane.sh
[help]
	autocorrect = prompt
[push]
	autoSetupRemote = true
	followTags = true
	default = simple
