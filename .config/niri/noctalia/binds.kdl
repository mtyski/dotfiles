binds {
    // Core Noctalia binds
    Mod+Space hotkey-overlay-title="Open Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Open Control Center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+N hotkey-overlay-title="Open Notifications Tray" { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Alt+Escape hotkey-overlay-title="Clear notifications" { spawn-sh "noctalia msg notification-clear-active && noctalia msg notification-clear-history"; }
    Mod+E hotkey-overlay-title="Open file manager (Nautilus)" { spawn "nautilus"; }
    Mod+Comma hotkey-overlay-title="Toggle Noctalia settings" { spawn-sh "noctalia msg settings-toggle"; }

    // Audio & Brightness
    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

    // Session panel
    Ctrl+Alt+Delete hotkey-overlay-title="Toggle session panel" { spawn-sh "noctalia msg panel-toggle session"; }

    // Lock screen
    Mod+Alt+L hotkey-overlay-title="Lock screen" { spawn-sh "noctalia msg session lock"; }
}
